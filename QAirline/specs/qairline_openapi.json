{
  "openapi": "3.0.0",
  "info": {
    "title": "QAirline API",
    "version": "1.0.0",
    "description": "Tài liệu từ các route, controller và Mongoose model hiện có. Một số lỗi xử lý và bảo mật của implementation chưa được chuẩn hóa thành hợp đồng mong muốn."
  },
  "servers": [{ "url": "/", "description": "Cùng origin với trang Swagger UI" }],
  "tags": [
    { "name": "Users" }, { "name": "Airports" }, { "name": "Aircrafts" },
    { "name": "Flights" }, { "name": "Passengers" }, { "name": "Bookings" },
    { "name": "Content" }, { "name": "Files" }, { "name": "Statistics" }, { "name": "Scheduler" }
  ],
  "paths": {
    "/api/users": {
      "get": { "tags": ["Users"], "operationId": "listUsers", "summary": "Danh sách người dùng", "responses": { "200": { "$ref": "#/components/responses/UserList" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Users"], "operationId": "createUser", "summary": "Tạo người dùng", "requestBody": { "$ref": "#/components/requestBodies/UserCreate" }, "x-id-path": "$.user._id", "responses": { "201": { "$ref": "#/components/responses/UserCreated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/users/login": {
      "post": { "tags": ["Users"], "operationId": "loginUser", "summary": "Đăng nhập", "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "$ref": "#/components/responses/LoginSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Users"], "operationId": "getUser", "summary": "Lấy người dùng theo ID", "responses": { "200": { "$ref": "#/components/responses/User" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "put": { "tags": ["Users"], "operationId": "updateUser", "summary": "Cập nhật người dùng", "requestBody": { "$ref": "#/components/requestBodies/UserUpdate" }, "responses": { "200": { "$ref": "#/components/responses/UserUpdated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Users"], "operationId": "deleteUser", "summary": "Xóa người dùng", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/airports": {
      "get": { "tags": ["Airports"], "operationId": "listAirports", "summary": "Danh sách sân bay", "responses": { "200": { "$ref": "#/components/responses/AirportList" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Airports"], "operationId": "createAirport", "summary": "Tạo sân bay", "requestBody": { "$ref": "#/components/requestBodies/AirportCreate" }, "x-id-path": "$.airport._id", "responses": { "201": { "$ref": "#/components/responses/AirportCreated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/airports/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Airports"], "operationId": "getAirport", "summary": "Lấy sân bay theo ID", "responses": { "200": { "$ref": "#/components/responses/AirportWrapped" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "put": { "tags": ["Airports"], "operationId": "updateAirport", "summary": "Cập nhật sân bay", "requestBody": { "$ref": "#/components/requestBodies/AirportUpdate" }, "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "400": { "$ref": "#/components/responses/BadRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Airports"], "operationId": "deleteAirport", "summary": "Xóa sân bay", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/aircrafts": {
      "get": { "tags": ["Aircrafts"], "operationId": "listAircrafts", "summary": "Danh sách máy bay", "responses": { "200": { "$ref": "#/components/responses/AircraftList" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Aircrafts"], "operationId": "createAircraft", "summary": "Tạo máy bay", "requestBody": { "$ref": "#/components/requestBodies/AircraftCreate" }, "x-id-path": "$.aircraft._id", "responses": { "201": { "$ref": "#/components/responses/AircraftCreated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/aircrafts/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Aircrafts"], "operationId": "getAircraft", "summary": "Lấy máy bay theo ID", "responses": { "200": { "$ref": "#/components/responses/Aircraft" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "put": { "tags": ["Aircrafts"], "operationId": "updateAircraft", "summary": "Cập nhật máy bay", "requestBody": { "$ref": "#/components/requestBodies/AircraftUpdate" }, "responses": { "200": { "$ref": "#/components/responses/AircraftUpdated" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Aircrafts"], "operationId": "deleteAircraft", "summary": "Xóa máy bay", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/aircrafts/type/{type}": {
      "parameters": [{ "name": "type", "in": "path", "required": true, "schema": { "type": "string", "enum": ["Narrow Body", "Wide Body", "Regional Jet"] } }],
      "get": { "tags": ["Aircrafts"], "operationId": "getAircraftsByType", "summary": "Lọc máy bay theo loại", "responses": { "200": { "$ref": "#/components/responses/AircraftList" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/flights": {
      "get": { "tags": ["Flights"], "operationId": "listFlights", "summary": "Danh sách chuyến bay", "responses": { "200": { "$ref": "#/components/responses/FlightList" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Flights"], "operationId": "createFlight", "summary": "Tạo chuyến bay", "description": "Cần hai Airport và một Aircraft đã tồn tại; arrivalTime phải sau departureTime.", "requestBody": { "$ref": "#/components/requestBodies/FlightCreate" }, "x-id-path": "$.flight._id", "responses": { "201": { "$ref": "#/components/responses/FlightCreated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/flights/search": {
      "post": { "tags": ["Flights"], "operationId": "searchFlights", "summary": "Tìm chuyến bay theo thành phố/ngày/số khách", "requestBody": { "$ref": "#/components/requestBodies/FlightSearch" }, "responses": { "200": { "$ref": "#/components/responses/FlightSearchResults" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/flights/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Flights"], "operationId": "getFlight", "summary": "Lấy chuyến bay theo ID", "responses": { "200": { "$ref": "#/components/responses/Flight" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "put": { "tags": ["Flights"], "operationId": "updateFlight", "summary": "Cập nhật chuyến bay", "requestBody": { "$ref": "#/components/requestBodies/FlightUpdate" }, "responses": { "200": { "$ref": "#/components/responses/FlightUpdated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Flights"], "operationId": "deleteFlight", "summary": "Xóa chuyến bay", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/flights/code/{code}": {
      "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Flights"], "operationId": "getFlightByCode", "summary": "Tra chuyến bay theo mã", "responses": { "200": { "$ref": "#/components/responses/Flight" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/passengers": {
      "get": { "tags": ["Passengers"], "operationId": "listPassengers", "summary": "Danh sách hành khách", "responses": { "200": { "$ref": "#/components/responses/PassengerList" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Passengers"], "operationId": "createPassenger", "summary": "Tạo hành khách", "requestBody": { "$ref": "#/components/requestBodies/PassengerCreate" }, "x-id-path": "$.passenger._id", "responses": { "201": { "$ref": "#/components/responses/PassengerCreated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/passengers/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Passengers"], "operationId": "getPassenger", "summary": "Lấy hành khách theo ID", "responses": { "200": { "$ref": "#/components/responses/Passenger" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/bookings": {
      "get": { "tags": ["Bookings"], "operationId": "listBookings", "summary": "Danh sách booking", "responses": { "200": { "$ref": "#/components/responses/BookingList" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Bookings"], "operationId": "createBooking", "summary": "Tạo booking", "description": "Cần User, Flight và các Passenger đã tồn tại; passengerIDs.length phải bằng passengerCount. totalPrice được tính từ giá hạng ghế.", "requestBody": { "$ref": "#/components/requestBodies/BookingCreate" }, "x-id-path": "$.booking._id", "responses": { "201": { "$ref": "#/components/responses/BookingCreated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/bookings/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Bookings"], "operationId": "getBooking", "summary": "Lấy booking theo ID", "responses": { "200": { "$ref": "#/components/responses/Booking" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "put": { "tags": ["Bookings"], "operationId": "updateBooking", "summary": "Đổi chuyến bay hoặc hạng ghế", "requestBody": { "$ref": "#/components/requestBodies/BookingUpdate" }, "responses": { "200": { "$ref": "#/components/responses/BookingUpdated" }, "400": { "$ref": "#/components/responses/BadRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Bookings"], "operationId": "deleteBooking", "summary": "Hủy booking", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/bookings/user/{userID}": {
      "parameters": [
        { "name": "userID", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ObjectId" } },
        { "name": "type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["Upcoming", "Past"] } }
      ],
      "get": { "tags": ["Bookings"], "operationId": "listUserBookings", "summary": "Booking của một người dùng", "responses": { "200": { "$ref": "#/components/responses/BookingList" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/bookings/rank/popular-flights": {
      "get": { "tags": ["Bookings"], "operationId": "listPopularFlights", "summary": "Các tuyến bay có nhiều booking", "responses": { "200": { "$ref": "#/components/responses/GenericArray" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/content": {
      "get": { "tags": ["Content"], "operationId": "listContent", "summary": "Danh sách nội dung", "responses": { "200": { "$ref": "#/components/responses/ContentList" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "post": { "tags": ["Content"], "operationId": "createContent", "summary": "Tạo nội dung", "requestBody": { "$ref": "#/components/requestBodies/ContentCreate" }, "responses": { "201": { "$ref": "#/components/responses/SuccessMessage" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/content/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Content"], "operationId": "getContent", "summary": "Lấy nội dung theo ID", "responses": { "200": { "$ref": "#/components/responses/Content" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "put": { "tags": ["Content"], "operationId": "updateContent", "summary": "Cập nhật nội dung", "requestBody": { "$ref": "#/components/requestBodies/ContentUpdate" }, "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Content"], "operationId": "deleteContent", "summary": "Xóa nội dung", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/files": {
      "get": { "tags": ["Files"], "operationId": "listFiles", "summary": "Danh sách file GridFS", "responses": { "200": { "$ref": "#/components/responses/GenericArray" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/files/upload": {
      "post": { "tags": ["Files"], "operationId": "uploadFile", "summary": "Upload ảnh vào GridFS", "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["image"], "properties": { "image": { "type": "string", "format": "binary" } } } } } }, "responses": { "201": { "$ref": "#/components/responses/SuccessMessage" }, "400": { "$ref": "#/components/responses/BadRequest" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/files/{identifier}": {
      "parameters": [{ "name": "identifier", "in": "path", "required": true, "description": "GET nhận filename; DELETE nhận MongoDB file ID.", "schema": { "type": "string" } }],
      "get": { "tags": ["Files"], "operationId": "getFile", "summary": "Lấy thông tin file theo tên", "responses": { "200": { "$ref": "#/components/responses/GenericObject" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } },
      "delete": { "tags": ["Files"], "operationId": "deleteFile", "summary": "Xóa file theo ID", "responses": { "200": { "$ref": "#/components/responses/SuccessMessage" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/files/image/{filename}": {
      "parameters": [{ "name": "filename", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Files"], "operationId": "getImage", "summary": "Tải nội dung ảnh", "responses": { "200": { "description": "Binary image", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/api/statistics": {
      "get": { "tags": ["Statistics"], "operationId": "getStatistics", "summary": "Thống kê booking, doanh thu và người dùng", "responses": { "200": { "$ref": "#/components/responses/Statistics" }, "500": { "$ref": "#/components/responses/ServerError" } } }
    },
    "/scheduler/start": {
      "post": { "tags": ["Scheduler"], "operationId": "startScheduler", "summary": "Bật tác vụ cập nhật trạng thái chuyến bay", "responses": { "200": { "description": "Scheduler started" } } }
    },
    "/scheduler/stop": {
      "post": { "tags": ["Scheduler"], "operationId": "stopScheduler", "summary": "Dừng tác vụ cập nhật trạng thái chuyến bay", "responses": { "200": { "description": "Scheduler stopped" } } }
    },
    "/scheduler/status": {
      "get": { "tags": ["Scheduler"], "operationId": "getSchedulerStatus", "summary": "Trạng thái scheduler", "responses": { "200": { "description": "running hoặc stopped", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "enum": ["running", "stopped"] } } } } } } } }
    }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ObjectId" } }
    },
    "schemas": {
      "ObjectId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$", "example": "a10000000000000000000001" },
      "Error": { "type": "object", "properties": { "message": { "type": "string" } } },
      "Airport": { "type": "object", "required": ["_id", "code", "name", "city"], "properties": { "_id": { "$ref": "#/components/schemas/ObjectId" }, "code": { "type": "string", "example": "SGN" }, "name": { "type": "string" }, "city": { "type": "string" } } },
      "AirportCreate": { "type": "object", "required": ["code", "name", "city"], "properties": { "code": { "type": "string", "example": "SGN" }, "name": { "type": "string", "example": "Tan Son Nhat International Airport" }, "city": { "type": "string", "example": "Ho Chi Minh City" } } },
      "Aircraft": { "type": "object", "required": ["_id", "code", "manufacturer", "model", "seats", "type", "range", "cruiseSpeed", "engineType", "inService", "lastMaintenance", "nextMaintenance"], "properties": { "_id": { "$ref": "#/components/schemas/ObjectId" }, "code": { "type": "string" }, "manufacturer": { "type": "string" }, "model": { "type": "string" }, "seats": { "type": "integer" }, "type": { "type": "string", "enum": ["Narrow Body", "Wide Body", "Regional Jet"] }, "range": { "type": "number" }, "cruiseSpeed": { "type": "number" }, "engineType": { "type": "string" }, "inService": { "type": "boolean" }, "lastMaintenance": { "type": "string" }, "nextMaintenance": { "type": "string" } } },
      "AircraftCreate": { "type": "object", "required": ["code", "manufacturer", "model", "seats", "type", "range", "cruiseSpeed", "engineType", "inService", "lastMaintenance", "nextMaintenance"], "properties": { "code": { "type": "string" }, "manufacturer": { "type": "string" }, "model": { "type": "string" }, "seats": { "type": "integer" }, "type": { "type": "string", "enum": ["Narrow Body", "Wide Body", "Regional Jet"] }, "range": { "type": "number" }, "cruiseSpeed": { "type": "number" }, "engineType": { "type": "string" }, "inService": { "type": "boolean" }, "lastMaintenance": { "type": "string" }, "nextMaintenance": { "type": "string" } } },
      "FlightClass": { "type": "object", "required": ["economy", "business"], "properties": { "economy": { "$ref": "#/components/schemas/Fare" }, "business": { "$ref": "#/components/schemas/Fare" } } },
      "Fare": { "type": "object", "required": ["price", "seatsAvailable"], "properties": { "price": { "type": "number", "minimum": 0 }, "seatsAvailable": { "type": "integer", "minimum": 0 } } },
      "FlightCreate": { "type": "object", "required": ["flightCode", "departureAirport", "arrivalAirport", "departureTime", "arrivalTime", "flightClass", "aircraft", "flightStatus"], "properties": { "flightCode": { "type": "string" }, "departureAirport": { "$ref": "#/components/schemas/ObjectId" }, "arrivalAirport": { "$ref": "#/components/schemas/ObjectId" }, "departureTime": { "type": "string", "format": "date-time" }, "arrivalTime": { "type": "string", "format": "date-time" }, "flightClass": { "$ref": "#/components/schemas/FlightClass" }, "aircraft": { "$ref": "#/components/schemas/ObjectId" }, "flightStatus": { "type": "string", "enum": ["Scheduled", "On time", "Delayed", "Landed", "In flight"] } } },
      "Flight": { "allOf": [{ "$ref": "#/components/schemas/FlightCreate" }, { "type": "object", "required": ["_id", "flightDuration"], "properties": { "_id": { "$ref": "#/components/schemas/ObjectId" }, "flightDuration": { "type": "string" } } }] },
      "FlightSearch": { "type": "object", "required": ["departureCity", "destinationCity", "departureDate", "passengerCount"], "properties": { "departureCity": { "type": "string", "example": "Ho Chi Minh City" }, "destinationCity": { "type": "string", "example": "Ha Noi" }, "departureDate": { "type": "string", "format": "date" }, "passengerCount": { "type": "integer", "minimum": 1 } } },
      "User": { "type": "object", "required": ["_id", "name", "username", "role"], "description": "Mô tả các trường cần dùng; implementation hiện có thể trả thêm password hash, cần đánh giá riêng như lỗi bảo mật.", "properties": { "_id": { "$ref": "#/components/schemas/ObjectId" }, "name": { "type": "string" }, "username": { "type": "string" }, "role": { "type": "string", "enum": ["user", "admin"] }, "bookings": { "type": "array", "items": { "$ref": "#/components/schemas/ObjectId" } } } },
      "UserCreate": { "type": "object", "required": ["name", "username", "password"], "properties": { "name": { "type": "string" }, "username": { "type": "string" }, "password": { "type": "string", "format": "password" }, "role": { "type": "string", "enum": ["user", "admin"], "default": "user" } } },
      "Login": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password" } } },
      "Passenger": { "type": "object", "required": ["_id", "name", "email"], "properties": { "_id": { "$ref": "#/components/schemas/ObjectId" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" } } },
